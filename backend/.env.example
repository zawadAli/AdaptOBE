APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/adaptobe

JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWORD_ENCRYPTION_KEY=changeme-generate-a-fernet-key

CORS_ORIGINS=http://localhost:5173

# Free API key from https://console.groq.com -- used for the generative AI
# features: Create CLO with AI, Upload Assessment Paper, and the AdaptOBE
# Assistant chatbot. Leave blank to disable them; everything else works without
# it, and the assistant falls back to showing matching help articles.
GROQ_API_KEY=your_groq_api_key_here
